{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "honba-core Domain Schema",
  "type": "object",
  "properties": {
    "Price": {
      "type": "object",
      "title": "Price",
      "description": "Exact decimal price with strict positive invariants",
      "properties": {
        "value": {
          "type": "string",
          "description": "Decimal price as string"
        }
      },
      "required": [
        "value"
      ]
    },
    "Quantity": {
      "type": "object",
      "title": "Quantity",
      "description": "Share or contract count with non-negative invariants",
      "properties": {
        "value": {
          "type": "string",
          "description": "Decimal quantity as string"
        }
      },
      "required": [
        "value"
      ]
    },
    "Money": {
      "type": "object",
      "title": "Money",
      "description": "Currency-aware financial amount",
      "properties": {
        "amount": {
          "type": "string",
          "description": "Decimal amount as string"
        },
        "currency": {
          "type": "string",
          "description": "Currency enum (INR)"
        }
      },
      "required": [
        "amount",
        "currency"
      ]
    },
    "Currency": {
      "type": "object",
      "title": "Currency",
      "description": "Minor-unit exponent definition",
      "enum": [
        "INR"
      ]
    },
    "Exchange": {
      "type": "object",
      "title": "Exchange",
      "description": "Supported exchanges in the Indian market",
      "enum": [
        "NSE",
        "BSE",
        "MCX"
      ]
    },
    "InstrumentId": {
      "type": "object",
      "title": "InstrumentId",
      "description": "Canonical instrument identifier",
      "properties": {
        "exchange": {
          "type": "string",
          "enum": [
            "NSE",
            "BSE",
            "MCX"
          ]
        },
        "symbol": {
          "type": "string"
        },
        "token": {
          "type": [
            "string",
            "null"
          ]
        },
        "isin": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "exchange",
        "symbol"
      ]
    },
    "PriceBand": {
      "type": "object",
      "title": "PriceBand",
      "description": "Daily scrip-wise or index circuit limit",
      "properties": {
        "lower": {
          "$ref": "#/components/parameters/Price"
        },
        "upper": {
          "$ref": "#/components/parameters/Price"
        },
        "reference_price": {
          "$ref": "#/components/parameters/Price"
        },
        "band_pct": {
          "type": [
            "number",
            "null"
          ]
        }
      },
      "required": [
        "lower",
        "upper",
        "reference_price"
      ]
    },
    "OrderSide": {
      "type": "object",
      "title": "OrderSide",
      "description": "Order direction",
      "enum": [
        "BUY",
        "SELL"
      ]
    },
    "OrderType": {
      "type": "object",
      "title": "OrderType",
      "description": "Order type specification",
      "properties": {
        "type": {
          "type": "string"
        }
      },
      "required": [
        "type"
      ]
    },
    "TimeInForce": {
      "type": "object",
      "title": "TimeInForce",
      "description": "Order validity period",
      "enum": [
        "DAY",
        "IOC",
        "GTC"
      ]
    },
    "OrderStatus": {
      "type": "object",
      "title": "OrderStatus",
      "description": "Order lifecycle status",
      "enum": [
        "PendingNew",
        "New",
        "PartiallyFilled",
        "Filled",
        "Cancelled",
        "Rejected",
        "Expired"
      ]
    },
    "OrderRequest": {
      "type": "object",
      "title": "OrderRequest",
      "description": "Outbound order intent",
      "properties": {
        "client_order_id": {
          "type": "string",
          "format": "uuid"
        },
        "instrument": {
          "$ref": "#/components/schemas/InstrumentId"
        },
        "side": {
          "type": "string",
          "enum": [
            "BUY",
            "SELL"
          ]
        },
        "order_type": {
          "$ref": "#/components/schemas/OrderType"
        },
        "quantity": {
          "$ref": "#/components/schemas/Quantity"
        },
        "tif": {
          "type": "string",
          "enum": [
            "DAY",
            "IOC",
            "GTC"
          ]
        },
        "algo_id": {
          "type": "string"
        },
        "tag": {
          "type": [
            "string",
            "null"
          ]
        },
        "client_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "correlation_id": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        },
        "trace_context": {
          "type": [
            "object",
            "null"
          ],
          "$ref": "#/components/schemas/TraceContext"
        }
      },
      "required": [
        "client_order_id",
        "instrument",
        "side",
        "order_type",
        "quantity",
        "tif",
        "algo_id"
      ]
    },
    "OrderAck": {
      "type": "object",
      "title": "OrderAck",
      "description": "Broker confirmation",
      "properties": {
        "order_id": {
          "type": "string"
        },
        "client_order_id": {
          "type": "string",
          "format": "uuid"
        },
        "exchange_order_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "$ref": "#/components/schemas/OrderStatus"
        },
        "timestamp": {
          "type": "string",
          "format": "date-time"
        },
        "correlation_id": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        },
        "client_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "trace_context": {
          "type": [
            "object",
            "null"
          ],
          "$ref": "#/components/schemas/TraceContext"
        }
      },
      "required": [
        "order_id",
        "client_order_id",
        "status",
        "timestamp"
      ]
    },
    "FillReport": {
      "type": "object",
      "title": "FillReport",
      "description": "Execution fill report",
      "properties": {
        "fill_id": {
          "type": "string"
        },
        "order_id": {
          "type": "string"
        },
        "client_order_id": {
          "type": "string",
          "format": "uuid"
        },
        "instrument": {
          "$ref": "#/components/schemas/InstrumentId"
        },
        "side": {
          "type": "string",
          "enum": [
            "BUY",
            "SELL"
          ]
        },
        "price": {
          "$ref": "#/components/schemas/Price"
        },
        "quantity": {
          "$ref": "#/components/schemas/Quantity"
        },
        "algo_id": {
          "type": "string"
        },
        "timestamp": {
          "type": "string",
          "format": "date-time"
        },
        "correlation_id": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        },
        "client_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "trace_context": {
          "type": [
            "object",
            "null"
          ],
          "$ref": "#/components/schemas/TraceContext"
        }
      },
      "required": [
        "fill_id",
        "order_id",
        "client_order_id",
        "instrument",
        "side",
        "price",
        "quantity",
        "algo_id",
        "timestamp"
      ]
    },
    "CancelRequest": {
      "type": "object",
      "title": "CancelRequest",
      "description": "Cancel request for existing order",
      "properties": {
        "instrument": {
          "$ref": "#/components/schemas/InstrumentId"
        },
        "client_order_id": {
          "type": "string",
          "format": "uuid"
        },
        "algo_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "client_id": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "instrument",
        "client_order_id"
      ]
    },
    "ModifyRequest": {
      "type": "object",
      "title": "ModifyRequest",
      "description": "Modify request for existing order",
      "properties": {
        "instrument": {
          "$ref": "#/components/schemas/InstrumentId"
        },
        "new_qty": {
          "type": [
            "string",
            "null"
          ]
        },
        "new_price": {
          "$ref": "#/components/schemas/Price"
        },
        "algo_id": {
          "type": "string"
        },
        "client_id": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "instrument",
        "algo_id"
      ]
    },
    "Decision": {
      "type": "object",
      "title": "Decision",
      "description": "Closed enum representing all permissible strategy decisions",
      "properties": {
        "action": {
          "type": "string"
        },
        "symbol": {
          "type": "string"
        },
        "side": {
          "type": "string",
          "enum": [
            "BUY",
            "SELL"
          ]
        },
        "qty": {
          "$ref": "#/components/schemas/Quantity"
        },
        "price_limit": {
          "$ref": "#/components/schemas/Price"
        },
        "algo_id": {
          "type": "string"
        },
        "rationale": {
          "type": [
            "string",
            "null"
          ]
        },
        "instrument": {
          "$ref": "#/components/schemas/InstrumentId"
        },
        "new_qty": {
          "type": [
            "string",
            "null"
          ]
        },
        "new_price": {
          "$ref": "#/components/schemas/Price"
        }
      },
      "required": [
        "action",
        "symbol",
        "algo_id"
      ]
    },
    "Tick": {
      "type": "object",
      "title": "Tick",
      "description": "Canonical typed Tick enum for broker feeds",
      "properties": {
        "type": {
          "type": "string"
        },
        "instrument": {
          "$ref": "#/components/schemas/InstrumentId"
        },
        "price": {
          "$ref": "#/components/schemas/Price"
        },
        "volume": {
          "$ref": "#/components/schemas/Quantity"
        },
        "bid": {
          "$ref": "#/components/schemas/Price"
        },
        "ask": {
          "$ref": "#/components/schemas/Price"
        },
        "bid_qty": {
          "$ref": "#/components/schemas/Quantity"
        },
        "ask_qty": {
          "$ref": "#/components/schemas/Quantity"
        },
        "last_price": {
          "type": [
            "object",
            "null"
          ],
          "$ref": "#/components/schemas/Price"
        },
        "bids": {
          "type": "array",
          "items": {
            "$ref": "#/components/schemas/DepthLevel"
          }
        },
        "asks": {
          "type": "array",
          "items": {
            "$ref": "#/components/schemas/DepthLevel"
          }
        }
      },
      "required": [
        "type"
      ]
    },
    "DepthLevel": {
      "type": "object",
      "title": "DepthLevel",
      "description": "Level 2 market depth entry",
      "properties": {
        "price": {
          "$ref": "#/components/schemas/Price"
        },
        "quantity": {
          "$ref": "#/components/schemas/Quantity"
        },
        "orders_count": {
          "type": [
            "integer",
            "null"
          ]
        }
      }
    },
    "Bar": {
      "type": "object",
      "title": "Bar",
      "description": "Standard OHLCV bar / candle",
      "properties": {
        "instrument": {
          "$ref": "#/components/schemas/InstrumentId"
        },
        "open": {
          "$ref": "#/components/schemas/Price"
        },
        "high": {
          "$ref": "#/components/schemas/Price"
        },
        "low": {
          "$ref": "#/components/schemas/Price"
        },
        "close": {
          "$ref": "#/components/schemas/Price"
        },
        "volume": {
          "$ref": "#/components/schemas/Quantity"
        },
        "timestamp": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "instrument",
        "open",
        "high",
        "low",
        "close",
        "volume",
        "timestamp"
      ]
    },
    "TraceContext": {
      "type": "object",
      "title": "TraceContext",
      "description": "Zero-dependency W3C distributed trace context carrier",
      "properties": {
        "trace_id": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          },
          "minItems": 16,
          "maxItems": 16
        },
        "span_id": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          },
          "minItems": 8,
          "maxItems": 8
        },
        "trace_flags": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        }
      },
      "required": [
        "trace_id",
        "span_id",
        "trace_flags"
      ]
    },
    "SizingMethod": {
      "type": "object",
      "title": "SizingMethod",
      "description": "Permissible dynamic position sizing models",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "fixed_fractional"
              ]
            },
            "risk_pct": {
              "type": "string",
              "description": "Decimal risk fraction as string"
            }
          },
          "required": [
            "type",
            "risk_pct"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "volatility_target"
              ]
            },
            "target_annual_vol": {
              "type": "string",
              "description": "Decimal target annual volatility as string"
            },
            "lookback_bars": {
              "type": "integer",
              "minimum": 1
            }
          },
          "required": [
            "type",
            "target_annual_vol",
            "lookback_bars"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "kelly_criterion"
              ]
            },
            "fraction": {
              "type": "string",
              "description": "Decimal fraction as string"
            },
            "win_rate": {
              "type": "string",
              "description": "Decimal win rate as string"
            },
            "payoff_ratio": {
              "type": "string",
              "description": "Decimal payoff ratio as string"
            }
          },
          "required": [
            "type",
            "fraction",
            "win_rate",
            "payoff_ratio"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "equal_risk_contribution"
              ]
            }
          },
          "required": [
            "type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "fixed_notional"
              ]
            },
            "notional": {
              "$ref": "#/components/schemas/Money"
            }
          },
          "required": [
            "type",
            "notional"
          ]
        }
      ]
    },
    "RiskBudget": {
      "type": "object",
      "title": "RiskBudget",
      "description": "Risk parameters and sizing constraints for dynamic sizing",
      "properties": {
        "equity": {
          "$ref": "#/components/schemas/Money"
        },
        "risk_pct": {
          "type": "string",
          "description": "Decimal risk percentage as string"
        },
        "max_position_notional": {
          "type": [
            "object",
            "null"
          ],
          "$ref": "#/components/schemas/Money"
        },
        "max_position_qty": {
          "type": [
            "object",
            "null"
          ],
          "$ref": "#/components/schemas/Quantity"
        },
        "max_portfolio_risk_pct": {
          "type": [
            "string",
            "null"
          ]
        },
        "min_lot_size": {
          "$ref": "#/components/schemas/Quantity"
        },
        "freeze_limit_qty": {
          "type": [
            "object",
            "null"
          ],
          "$ref": "#/components/schemas/Quantity"
        }
      },
      "required": [
        "equity",
        "risk_pct",
        "min_lot_size"
      ]
    },
    "PositionSizingRequest": {
      "type": "object",
      "title": "PositionSizingRequest",
      "description": "Request to compute dynamic position sizing for an instrument trade intent",
      "properties": {
        "instrument": {
          "$ref": "#/components/schemas/InstrumentId"
        },
        "side": {
          "type": "string",
          "enum": [
            "LONG",
            "SHORT"
          ]
        },
        "entry_price": {
          "$ref": "#/components/schemas/Price"
        },
        "stop_loss": {
          "type": [
            "object",
            "null"
          ],
          "$ref": "#/components/schemas/Price"
        },
        "current_volatility": {
          "type": [
            "string",
            "null"
          ]
        },
        "account_equity": {
          "$ref": "#/components/schemas/Money"
        },
        "risk_budget": {
          "$ref": "#/components/schemas/RiskBudget"
        },
        "sizing_method": {
          "$ref": "#/components/schemas/SizingMethod"
        }
      },
      "required": [
        "instrument",
        "side",
        "entry_price",
        "account_equity",
        "risk_budget",
        "sizing_method"
      ]
    },
    "PositionSizingResult": {
      "type": "object",
      "title": "PositionSizingResult",
      "description": "Output of dynamic position sizing",
      "properties": {
        "instrument": {
          "$ref": "#/components/schemas/InstrumentId"
        },
        "quantity": {
          "$ref": "#/components/schemas/Quantity"
        },
        "allocated_notional": {
          "$ref": "#/components/schemas/Money"
        },
        "risk_at_stake": {
          "$ref": "#/components/schemas/Money"
        },
        "target_weight": {
          "type": [
            "string",
            "null"
          ]
        },
        "capped_by_limit": {
          "type": "boolean"
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "instrument",
        "quantity",
        "allocated_notional",
        "risk_at_stake",
        "capped_by_limit"
      ]
    },
    "DomainEvent": {
      "type": "object",
      "title": "DomainEvent",
      "description": "Tactical DDD aggregate domain events representing authoritative platform state transitions",
      "properties": {
        "type": {
          "type": "string"
        },
        "timestamp": {
          "type": "string",
          "format": "date-time"
        },
        "trace_context": {
          "type": [
            "object",
            "null"
          ],
          "$ref": "#/components/schemas/TraceContext"
        }
      },
      "required": [
        "type",
        "timestamp"
      ]
    },
    "Signal": {
      "type": "object",
      "title": "Signal",
      "description": "Enriched trade strategy/indicator signal",
      "properties": {
        "instrument": {
          "$ref": "#/components/schemas/InstrumentId"
        },
        "direction": {
          "type": "string",
          "enum": [
            "bullish",
            "bearish",
            "neutral"
          ]
        },
        "horizon": {
          "type": "string",
          "enum": [
            "intraday",
            "swing",
            "positional"
          ]
        },
        "timeframe": {
          "type": "string",
          "enum": [
            "m1",
            "m5",
            "m15",
            "m30",
            "h1",
            "d1",
            "w1"
          ]
        },
        "strength": {
          "type": "string"
        },
        "generated_by": {
          "type": "string"
        },
        "timestamp": {
          "type": "string",
          "format": "date-time"
        },
        "entry_price": {
          "type": [
            "object",
            "null"
          ],
          "$ref": "#/components/schemas/Price"
        },
        "stop_loss": {
          "type": [
            "object",
            "null"
          ],
          "$ref": "#/components/schemas/Price"
        },
        "take_profit": {
          "type": [
            "object",
            "null"
          ],
          "$ref": "#/components/schemas/Price"
        },
        "volatility_atr": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "instrument",
        "direction",
        "horizon",
        "timeframe",
        "strength",
        "generated_by",
        "timestamp"
      ]
    }
  },
  "required": [
    "Price",
    "Quantity",
    "Money",
    "Currency",
    "Exchange",
    "InstrumentId",
    "PriceBand",
    "OrderSide",
    "OrderType",
    "TimeInForce",
    "OrderStatus",
    "OrderRequest",
    "OrderAck",
    "FillReport",
    "CancelRequest",
    "ModifyRequest",
    "Decision",
    "Tick",
    "DepthLevel",
    "Bar",
    "SizingMethod",
    "RiskBudget",
    "PositionSizingRequest",
    "PositionSizingResult",
    "DomainEvent",
    "TraceContext",
    "Signal"
  ]
}